# Normalize all text files to LF in the repository, and expand them to the
# platform's native line endings on checkout (CRLF on Windows, LF on macOS/Linux).
# This keeps diffs stable across machines and avoids repeated line-ending churn.
* text=auto

# Explicitly treat these as binary (no line-ending conversion, no diff noise)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.pyc binary
*.dll binary
*.exe binary
