<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BambuBar.Core</RootNamespace>
    <Version>1.3.0</Version>
    <Description>Windows protocol core for Bambu Bar: MQTT/TLS, discovery, report parsing.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MQTTnet" Version="4.3.6.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled data (localization, HMS catalog, CA certificates) is embedded so the app can
         ship as a single executable. Loose Resources\ files next to the executable still take
         precedence (see Bundled.Read), so dev builds can swap them without recompiling. -->
    <EmbeddedResource Include="Resources\certificates\**\*.pem" />
    <EmbeddedResource Include="Resources\hms_en.json" />
    <EmbeddedResource Include="Resources\loc\*.json" />
  </ItemGroup>

</Project>
